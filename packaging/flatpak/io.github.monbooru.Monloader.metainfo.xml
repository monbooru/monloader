<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.monbooru.Monloader</id>
  <name>Monloader</name>
  <summary>Downloader for monbooru</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-only</project_license>
  <launchable type="desktop-id">io.github.monbooru.Monloader.desktop</launchable>

  <description>
    <p>
      monloader allows you to download images and tags from the internet into your monbooru gallery: 
      it takes a booru or gallery URL, fetches the files and their tags through
      gallery-dl, and pushes them into a monbooru gallery. It also answers
      reverse lookups against boorus, IQDB and SauceNAO, and can sync the
      Hydrus Public Tag Repository to backfill tags by hash.
    </p>
  </description>

  <categories>
    <category>Network</category>
    <category>FileTransfer</category>
  </categories>

  <url type="homepage">https://github.com/monbooru/monloader</url>
  <url type="bugtracker">https://github.com/monbooru/monloader/issues</url>
  <url type="help">https://monbooru.github.io/mondocs/addons/monloader/index.html</url>

  <content_rating type="oars-1.1"/>

  <!-- Filled at build time from VERSION.md and the newest CHANGELOG.md heading. -->
  <releases>
    <!--RELEASE-->
  </releases>
</component>
